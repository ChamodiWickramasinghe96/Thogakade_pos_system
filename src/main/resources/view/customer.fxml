<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXTextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="customerContext" prefHeight="417.0" prefWidth="590.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CustomerController">
   <children>
      <Label layoutX="204.0" layoutY="13.0" text="CUSTOMER FORM">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <TableView fx:id="tblCustomer" layoutX="37.0" layoutY="160.0" prefHeight="200.0" prefWidth="516.0" stylesheets="@../css/Style.css">
        <columns>
          <TableColumn fx:id="colId" prefWidth="127.0" text="Id" />
          <TableColumn fx:id="colName" prefWidth="135.0" text="Name" />
            <TableColumn fx:id="colAddress" prefWidth="141.0" text="Address" />
            <TableColumn fx:id="colSalary" prefWidth="112.0" text="Salary" />
        </columns>
      </TableView>
      <JFXTextField fx:id="txtId" layoutX="39.0" layoutY="70.0" prefHeight="25.0" prefWidth="99.0" promptText=" Id" />
      <JFXTextField fx:id="txtAddress" layoutX="313.0" layoutY="70.0" prefHeight="25.0" prefWidth="99.0" promptText="Address" />
      <JFXTextField fx:id="txtName" layoutX="170.0" layoutY="70.0" prefHeight="25.0" prefWidth="99.0" promptText="Name" />
      <JFXTextField fx:id="txtSalary" layoutX="454.0" layoutY="70.0" prefHeight="25.0" prefWidth="99.0" promptText="Salary" />
      <JFXButton layoutX="462.0" layoutY="17.0" onAction="#btnAddOnAction" prefHeight="27.0" prefWidth="91.0" style="-fx-background-color: #2ecc71;" text="Add">
         <font>
            <Font name="Arial Bold" size="13.0" />
         </font>
      </JFXButton>
      <JFXButton layoutX="454.0" layoutY="119.0" onAction="#btnUpdateOnAction" prefHeight="27.0" prefWidth="99.0" style="-fx-background-color: #f1c40f;" text="Update">
         <font>
            <Font name="Arial Bold" size="13.0" />
         </font>
      </JFXButton>
      <JFXButton layoutX="38.0" layoutY="119.0" onAction="#btnSearchOnAction" prefHeight="27.0" prefWidth="298.0" style="-fx-background-color: #dcdde1;" text="Search">
         <font>
            <Font name="Arial Bold" size="13.0" />
         </font>
      </JFXButton>
      <JFXButton layoutX="479.0" layoutY="375.0" onAction="#btnReloadOnAction" prefHeight="25.0" prefWidth="75.0" style="-fx-background-color: #EE5A24;" text="Reload">
         <font>
            <Font name="Arial Bold" size="13.0" />
         </font></JFXButton>
      <JFXButton layoutX="36.0" layoutY="17.0" onAction="#btnBacktoHomeOnAction" prefHeight="27.0" prefWidth="99.0" style="-fx-background-color: #718093;" text="Back to home">
         <font>
            <Font name="Arial Bold" size="12.0" />
         </font>
      </JFXButton>
      <JFXButton layoutX="346.0" layoutY="119.0" onAction="#btnDeleteOnAction" prefHeight="27.0" prefWidth="99.0" style="-fx-background-color: #e74c3c;" text="Delete">
         <font>
            <Font name="Arial Bold" size="13.0" />
         </font>
      </JFXButton>
   </children>
</AnchorPane>
