<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXComboBox?>
<?import com.jfoenix.controls.JFXTextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="orderContext" prefHeight="457.0" prefWidth="592.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.OrderController">
   <children>
      <Label layoutX="40.0" layoutY="79.0" text="CUSTOMER ">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <Label layoutX="40.0" layoutY="125.0" prefHeight="17.0" prefWidth="70.0" text="ITEM ">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <TableView fx:id="tblOrder" layoutX="39.0" layoutY="212.0" prefHeight="200.0" prefWidth="524.0" stylesheets="@../css/Style.css">
        <columns>
          <TableColumn fx:id="colItemCode" prefWidth="92.0" text="Item Code" />
          <TableColumn fx:id="colDescription" prefWidth="132.0" text="Description" />
            <TableColumn fx:id="colUnitPrice" minWidth="4.0" prefWidth="79.0" text="Unit Price" />
            <TableColumn fx:id="colQty" prefWidth="96.0" text="Qty" />
            <TableColumn fx:id="colTotal" prefWidth="124.0" text="Total" />
        </columns>
      </TableView>
      <Button layoutX="474.0" layoutY="418.0" mnemonicParsing="false" onAction="#btnPlaceOrderOnAction" style="-fx-background-color: #3498db;" text="Place Order">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
      <JFXComboBox fx:id="combCustomer" layoutX="149.0" layoutY="76.0" promptText="ID" />
      <JFXTextField fx:id="txtCusName" layoutX="298.0" layoutY="74.0" opacity="0.65" prefHeight="25.0" prefWidth="76.0" promptText="Name" />
      <JFXTextField fx:id="txtAddress" layoutX="392.0" layoutY="74.0" opacity="0.65" prefHeight="25.0" prefWidth="76.0" promptText="Address" />
      <JFXTextField fx:id="txtSalary" layoutX="484.0" layoutY="74.0" opacity="0.65" prefHeight="25.0" prefWidth="76.0" promptText="Salary" />
      <JFXComboBox fx:id="combItem" layoutX="149.0" layoutY="123.0" promptText="Code" />
      <JFXTextField fx:id="txtDescription" layoutX="298.0" layoutY="120.0" opacity="0.79" prefHeight="25.0" prefWidth="76.0" promptText="Description" />
      <JFXTextField fx:id="txtQtyOnHand" layoutX="392.0" layoutY="119.0" opacity="0.79" prefHeight="25.0" prefWidth="76.0" promptText="Stock" />
      <JFXTextField fx:id="txtUnitPrice" layoutX="485.0" layoutY="119.0" opacity="0.79" prefHeight="25.0" prefWidth="76.0" promptText="Unit Price" />
      <JFXButton fx:id="lblAddToCart" layoutX="472.0" layoutY="170.0" onAction="#btnAddOrderOnAction" prefHeight="35.0" prefWidth="89.0" style="-fx-background-color: #2ecc71;" text="Add to Cart">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </JFXButton>
      <JFXTextField fx:id="txtQuantity" layoutX="298.0" layoutY="165.0" opacity="0.79" prefHeight="25.0" prefWidth="76.0" promptText="Qty on Hand" />
      <Label layoutX="48.0" layoutY="418.0" text="Net Total :" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <Label fx:id="lblNetTotal" layoutX="126.0" layoutY="419.0" text="00.00" textFill="#2c3e50">
         <font>
            <Font name="System Bold Italic" size="13.0" />
         </font>
      </Label>
      <JFXButton fx:id="btnClear" layoutX="401.0" layoutY="170.0" onAction="#btnClearOnAction" prefHeight="35.0" prefWidth="65.0" style="-fx-background-color: #e74c3c;" text="Clear">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </JFXButton>
      <Label layoutX="235.0" layoutY="14.0" text="ORDER FORM">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <JFXButton layoutX="41.0" layoutY="18.0" onAction="#btnBacktoHomeOnAction" prefHeight="27.0" prefWidth="99.0" style="-fx-background-color: #718093;" text="Back to home">
         <font>
            <Font name="Arial Bold" size="12.0" />
         </font>
      </JFXButton>
      <Label fx:id="lblOrderId" layoutX="464.0" layoutY="19.0" prefHeight="25.0" prefWidth="98.0" style="-fx-background-color: #f39c12;" text="  Order  Id" textAlignment="CENTER" textFill="#1b1a1a">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
